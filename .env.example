# Copie para .env e preencha. NUNCA versione o .env.

# Carteira que implanta o contrato (termina com saldo zero de CMRD).
PRIVATE_KEY=

# Enderecos dos tres fundos. Devem ser distintos entre si e diferentes de zero.
LIQUIDITY_FUND=
TREASURY_FUND=
SOLIDARITY_FUND=

# Verificacao do codigo-fonte no explorador.
BASESCAN_API_KEY=

# RPC proprio (opcional; ha um padrao publico para cada rede).
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
